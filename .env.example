# ==============================================================================
# TRINETRA Environment Configuration Template
# All production secrets must be managed via platform secret managers.
# NEVER commit real credentials or production keys to source control.
# ==============================================================================

# --- Frontend (apps/web) ---
NEXT_PUBLIC_APP_NAME="TRINETRA Severe Weather Nowcasting"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Public Configuration (Exposed to browser client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# MapLibre / Vector Tile Provider (e.g., OpenMapTiles, Protomaps, Carto, MapTiler)
NEXT_PUBLIC_MAP_TILE_STYLE_URL="https://demotiles.maplibre.org/style.json"

# Python ML Inference Service URL (Accessed by browser / Edge Functions)
NEXT_PUBLIC_INFERENCE_URL="http://localhost:8000"
ML_INFERENCE_SERVICE_URL="http://localhost:8000"
ML_INFERENCE_API_KEY="dev-internal-key"

# --- Backend Orchestration (Supabase Edge Functions / Server) ---
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-server-only"
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# --- Python ML Inference Service (services/inference) ---
INFERENCE_PORT=8000
INFERENCE_HOST="0.0.0.0"
INFERENCE_ENV="production"
LOG_LEVEL="INFO"
MODEL_VERSION="v1.0.0-conv3d-multitask"
RATE_LIMIT_PER_MINUTE=120

# Prometheus Telemetry & Metrics
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_METRICS_PATH="/metrics"

# Data Provider Configuration (Mock/Replay in development; verify terms before production)
DATA_STORAGE_PATH="./data/samples"
ENABLE_SYNTHETIC_REPLAY=true
