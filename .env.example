# ==============================================================================
# TRINETRA Production Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# - Copy this file to .env.local for local development, or configure these variables
#   directly in your deployment dashboards:
#     * Frontend: Vercel Project Settings -> Environment Variables
#     * Python ML Service: Render / Railway Dashboard -> Environment
#     * Database: Supabase Dashboard -> Project Settings -> API / Database
#
# CRITICAL SECURITY RULES:
# - NEVER commit real credentials or secrets to source control.
# - NEVER prefix server secrets (service-role keys, DB passwords) with NEXT_PUBLIC_.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY to client-side code.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND / NEXT.JS (apps/web) - Vercel Environment Variables
# ==============================================================================
NEXT_PUBLIC_APP_NAME="TRINETRA Severe Weather Nowcasting"
NEXT_PUBLIC_APP_ENV="production"
# Production site URL (Leave blank to automatically use Vercel URL, or set custom domain)
NEXT_PUBLIC_SITE_URL=

# Supabase Public Configuration (Safe for browser client)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre / Vector Tile Provider
NEXT_PUBLIC_MAP_TILE_STYLE_URL="https://demotiles.maplibre.org/style.json"

# Python ML Inference Service Public URL
# Set to your deployed FastAPI microservice HTTPS URL (e.g. https://trinetra-inference.onrender.com)
NEXT_PUBLIC_INFERENCE_URL=

# ==============================================================================
# 2. SERVER-ONLY SECRETS & BACKEND (apps/web server & edge runtimes)
# Keep strictly private on the server. NEVER prefix with NEXT_PUBLIC_.
# ==============================================================================
# Internal/Direct URL used by Next.js server rewrites to proxy to FastAPI
ML_INFERENCE_SERVICE_URL=

# Shared internal API authentication key between frontend and inference service
ML_INFERENCE_API_KEY=

# Supabase Service Role Key (Server-only; bypasses RLS for batch/admin operations)
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL + PostGIS Connection String
DATABASE_URL=

# ==============================================================================
# 3. PYTHON ML INFERENCE SERVICE (services/inference)
# Configure these in your Python hosting provider (Render, Railway, Fly.io)
# ==============================================================================
PORT=8000
INFERENCE_PORT=8000
INFERENCE_HOST="0.0.0.0"
INFERENCE_ENV="production"
LOG_LEVEL="INFO"
MODEL_VERSION="v1.0.0-conv3d-multitask"
RATE_LIMIT_PER_MINUTE=120

# CORS Allowed Frontend Domain(s) - Comma-separated if multiple
# Example: https://your-project.vercel.app
FRONTEND_URL=
ALLOWED_ORIGINS=

# Telemetry & Synthetic Replay
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_METRICS_PATH="/metrics"
DATA_STORAGE_PATH="./data/samples"
ENABLE_SYNTHETIC_REPLAY=true
