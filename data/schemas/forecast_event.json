{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TRINETRA Forecast Event Contract",
  "description": "Schema for hyper-local severe weather nowcast predictions generated by the ML engine",
  "type": "object",
  "required": [
    "forecast_id",
    "model_version",
    "generated_at",
    "data_timestamp",
    "horizon_minutes",
    "valid_time",
    "grid_cell_id",
    "centroid",
    "probabilities",
    "severity",
    "is_synthetic_replay"
  ],
  "properties": {
    "forecast_id": {
      "type": "string",
      "description": "Unique identifier for the forecast run"
    },
    "model_version": {
      "type": "string",
      "description": "Version tag of the forecasting model"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the forecast was computed"
    },
    "data_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of the latest input observation used"
    },
    "horizon_minutes": {
      "type": "integer",
      "minimum": 60,
      "maximum": 360,
      "description": "Forecast lead time in minutes (2-6 hour window)"
    },
    "valid_time": {
      "type": "string",
      "format": "date-time",
      "description": "UTC valid timestamp of the predicted event"
    },
    "grid_cell_id": {
      "type": "string",
      "description": "Unique identifier for the spatial grid cell"
    },
    "centroid": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2,
      "description": "[longitude, latitude] coordinates in EPSG:4326"
    },
    "probabilities": {
      "type": "object",
      "required": ["thunderstorm", "cloudburst", "flash_flood"],
      "properties": {
        "thunderstorm": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "cloudburst": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "flash_flood": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["none", "advisory", "watch", "warning"]
    },
    "is_synthetic_replay": {
      "type": "boolean",
      "description": "True if using simulated or historical replay data"
    },
    "terrain_factors": {
      "type": "object",
      "properties": {
        "slope_deg": { "type": "number" },
        "twi": { "type": "number" },
        "catchment_vuln": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "xai_attribution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "contribution"],
        "properties": {
          "feature": { "type": "string" },
          "contribution": { "type": "number" },
          "observed_value": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    }
  }
}
