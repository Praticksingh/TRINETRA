# ==============================================================================
# TRINETRA Local Environment Template (.env.local.example)
#
# Copy this file to .env.local for local development:
#   cp .env.local.example apps/web/.env.local
#
# IMPORTANT:
# - Do NOT commit .env.local to Git.
# - Placeholders below should be filled with your actual local or sandbox keys.
# ==============================================================================

# Application Meta
NEXT_PUBLIC_APP_NAME="TRINETRA Severe Weather Nowcasting"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre Map Styles
NEXT_PUBLIC_MAP_TILE_STYLE_URL="https://demotiles.maplibre.org/style.json"

# Python ML Inference Microservice
NEXT_PUBLIC_INFERENCE_URL="http://localhost:8000"
ML_INFERENCE_SERVICE_URL="http://localhost:8000"
ML_INFERENCE_API_KEY=

# Backend & Server Secrets (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
